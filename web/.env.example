# Supabase project that holds the aggregated fire record.
# The anon key is a public, row-level-security-scoped key: every policy in
# db/migrations/0001_init.sql grants select only, so it is safe in the browser.
# The service role key is NOT used by this app and must never be set here --
# the offline pipeline uses it directly and it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Renders seeded synthetic data instead of querying Supabase, so the UI can be
# built and reviewed before the pipeline has loaded anything. Every page shows a
# banner while it is on. Never enable it for a demo or a screenshot.
NEXT_PUBLIC_DEMO_DATA=false
